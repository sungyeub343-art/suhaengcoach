{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Commit and push site updates",
			"type": "shell",
			"command": "cmd.exe",
			"args": [
				"/d",
				"/c",
				"git add index.html installation.html installation.css regional-areas.html regional-area.html regions && git commit -m \"Add regional vending installation pages\" && git push origin main"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Stage all site updates",
			"type": "shell",
			"command": "git",
			"args": [
				"add",
				"-A"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Commit regional pages",
			"type": "shell",
			"command": "git",
			"args": [
				"commit",
				"-m",
				"regional-pages"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Push regional pages",
			"type": "shell",
			"command": "git",
			"args": [
				"push",
				"origin",
				"main"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Generate south region pages",
			"type": "shell",
			"command": "powershell.exe",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"generate-south-pages.ps1"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Generate Chungnam Jeonbuk Jeonnam pages",
			"type": "shell",
			"command": "python",
			"args": [
				"generate_south_pages.py"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Stage south region pages",
			"type": "shell",
			"command": "git",
			"args": [
				"add",
				"-A"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Commit south region pages",
			"type": "shell",
			"command": "git",
			"args": [
				"commit",
				"-m",
				"add-south-region-pages"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Push south region pages",
			"type": "shell",
			"command": "git",
			"args": [
				"push",
				"origin",
				"main"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Publish regional directory fixes",
			"type": "shell",
			"command": "git",
			"args": [
				"add",
				"regions/chungnam.html",
				"regions/jeonbuk.html",
				"regions/jeonnam.html"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Commit regional directory fixes",
			"type": "shell",
			"command": "git",
			"args": [
				"commit",
				"-m",
				"fix-south-region-directories"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Push directory fixes",
			"type": "shell",
			"command": "git",
			"args": [
				"push",
				"origin",
				"main"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Generate Gangwon Gyeongbuk Jeju pages",
			"type": "shell",
			"command": "python",
			"args": [
				"generate-east-pages.py"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Check pending regional changes",
			"type": "shell",
			"command": "git",
			"args": [
				"status",
				"--short"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Review task file diff",
			"type": "shell",
			"command": "git",
			"args": [
				"diff",
				"--",
				".vscode/tasks.json"
			],
			"isBackground": false,
			"problemMatcher": []
		}
	]
}